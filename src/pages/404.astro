---
import MainLayout from "../layouts/MainLayout.astro";
import GlassCard from "../components/GlassCard";

export const prerender = true;
---

<MainLayout title="404 - Page Not Found">
  <main class="min-h-screen flex items-center justify-center p-4">
    <GlassCard padding="large" className="max-w-md w-full text-center">
      <h1 class="text-6xl font-bold text-accent-coral mb-4">
        404
      </h1>
      <div class="text-2xl font-black text-accent-cyan mb-8 font-rajdhani">I can’t find that page.</div>
      <p class="text-gray-400 mb-8">
        It may have moved, or I may have broken a link while rearranging things. Either way, home is still here.
      </p>
      <a 
        href="/" 
        class="inline-block px-8 py-3 border-2 border-accent-cyan text-accent-cyan hover:bg-accent-cyan hover:text-dark transition-all duration-300 neon-glow"
      >
        Back home
      </a>
    </GlassCard>
  </main>
</MainLayout>
