---
import MainLayout from '../layouts/MainLayout.astro';
import MagicBento from '../components/MagicBento';
import GlassCard from '../components/GlassCard';
import { githubService } from '../lib/github';

// Fetch all repositories sorted and categorized at build time
const { all } = await githubService.getAllRepositoriesSorted();
const formattedAll = all.map(repo => githubService.formatRepository(repo));
---

<MainLayout title="Projects - Anton Vice">
  
  <main id="main-content" class="pt-16">
    <!-- Hero Section -->
    <section class="py-12 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
      <div class="max-w-6xl mx-auto relative z-10">
        <div class="text-center mb-8">
          <h1 class="text-4xl sm:text-6xl md:text-7xl font-black text-electric-blue electric-blue-glow mb-4">The GitHub shelf</h1>
          <p class="text-lg text-gray-300 max-w-2xl mx-auto leading-relaxed mb-6">
            Everything public: finished tools, research code, weekend experiments, and a few ideas that are still becoming themselves.
          </p>
          <div class="flex justify-center gap-3 flex-wrap">
            <a 
              href="https://github.com/antonvice" 
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center px-6 py-3 border-2 border-accent-yellow text-accent-yellow hover:bg-accent-yellow hover:text-dark transition-all duration-300 hover:shadow-lg hover:shadow-accent-yellow/50 neon-glow"
            >
              <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              Open GitHub
            </a>
            <a 
              href="/portfolio"
              class="inline-flex items-center px-6 py-3 border-2 border-accent-cyan text-accent-cyan hover:bg-accent-cyan hover:text-dark transition-all duration-300 hover:shadow-lg hover:shadow-accent-cyan/50"
            >
              <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 24 24">
                <path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/>
              </svg>
              Start with the portfolio
            </a>
          </div>
        </div>
        
        <p class="mx-auto mt-8 max-w-2xl text-center text-sm font-semibold text-dark/65">There are {all.length} repositories here. The portfolio is the edited version; this page is the workshop with the doors open.</p>
      </div>
    </section>

    <!-- All Projects Section with MagicBento -->
    <section class="py-12 px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto">
        <h2 class="text-3xl md:text-5xl font-black text-center text-accent-cyan mb-8">All the repos</h2>
        
        {formattedAll.length > 0 && (
          <MagicBento
            projects={formattedAll}
            textAutoHide={false}
            enableStars={true}
            enableSpotlight={true}
            enableBorderGlow={true}
            enableTilt={true}
            enableMagnetism={true}
            clickEffect={true}
            spotlightRadius={350}
            particleCount={10}
            glowColor="255, 95, 162"
            client:load
          />
        )}
      </div>
    </section>

    {all.length === 0 && (
      <section class="py-12 px-4 sm:px-6 lg:px-8">
        <div class="max-w-md mx-auto text-center">
          <GlassCard padding="large">
            <h3 class="text-2xl text-accent-yellow mb-4">GitHub is taking a minute.</h3>
            <p class="text-gray-400 mb-6">
              The projects are still available on my profile.
            </p>
            <a 
              href="https://github.com/antonvice" 
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block px-6 py-3 border border-accent-cyan text-accent-cyan hover:bg-accent-cyan hover:text-dark transition-all duration-300"
            >
              Visit GitHub Profile
            </a>
          </GlassCard>
        </div>
      </section>
    )}
  </main>
</MainLayout>
