---
import MainLayout from '../../layouts/MainLayout.astro';
import { getAllPosts, formatDate } from '../../lib/posts';
import type { BlogPost } from '../../lib/posts';
import GlassCard from '../../components/GlassCard';

// Get all blog posts
const allPosts = getAllPosts();

// Sort posts by date (newest first)
const sortedPosts = [...allPosts].sort((a, b) =>
  new Date(b.date).valueOf() - new Date(a.date).valueOf()
);

// Get featured posts (first 3 for now)
const featuredPosts = sortedPosts.slice(0, 3);

// Extract unique tags from content (simple approach)
const uniqueTags = ['AI', 'Machine Learning', 'Deep Learning', 'Python', 'GPT', 'Neural Networks', 'Philosophy', 'Technology'];
const readingMinutes = (post: BlogPost) => Math.max(2, Math.ceil(post.content.split(/\s+/).length / 220));
const getPostBadges = (post: BlogPost): string[] => {
  const text = `${post.title} ${post.excerpt}`.toLowerCase();
  const badges = [];

  if (/\b(?:rust|python|swift|code|programming|interview|rag)\b/.test(text)) badges.push('Engineering');
  if (/transformer|gpt|llm|\bai\b|machine learning|neural|reasoning|cognitive architecture/.test(text)) badges.push('AI');
  if (/philosophy|ethic|future|anthropocentric|browser|first principles|model fragmentation/.test(text)) badges.push('Essay');
  if (/clustering|quantization|kan|dbscan|optics/.test(text)) badges.push('Deep Dive');

  return (badges.length ? badges : ['Notes']).slice(0, 3);
};
const getPostTopics = (post: BlogPost): string[] => {
  const text = `${post.title} ${post.excerpt}`.toLowerCase();
  return uniqueTags.filter((tag) => {
    const patterns: Record<string, RegExp> = {
      AI: /\bai\b|llm|gpt|machine learning|neural|transformer|reasoning|neurosymbolic|model fragmentation/,
      'Machine Learning': /machine learning|model|clustering|classification|quantization|embedding|kaggle/,
      'Deep Learning': /deep learning|neural|transformer|gpt|llm|diffusion|kan|embedding/,
      Python: /python|pytorch|dbscan|optics|kaggle|streamlit/,
      GPT: /gpt|llm|transformer/,
      'Neural Networks': /neural|transformer|embedding|diffusion|kan|deep learning/,
      Philosophy: /philosophy|ethical|future|anthropocentric|human|conscious|society/,
      Technology: /technology|software|browser|blockchain|robot|ai|computer|programming/,
    };
    return patterns[tag]?.test(text) ?? false;
  });
};
---

<MainLayout title="Blog - Anton Vice" description="Essays, build notes, and practical AI research from Anton Vice.">
  
  <main id="main-content" class="pt-16">
    <!-- Hero Section -->
    <section class="relative overflow-hidden px-4 py-10 sm:px-6 sm:py-16 lg:px-8">
      <div class="max-w-7xl mx-auto relative z-10">
        <div class="mb-8 text-center sm:mb-12">
          <h1 class="mb-4 text-4xl font-black text-neon-blue neon-blue-glow sm:mb-6 sm:text-5xl md:text-7xl">
            Anton's Blog
          </h1>
          <p class="mx-auto mb-6 max-w-3xl text-lg leading-relaxed text-gray-300 sm:mb-8 sm:text-xl">
            Things I needed to think through in public: AI, software, robotics, philosophy, and whatever happens when those subjects refuse to stay separate.
          </p>
        </div>
        
        <!-- Topic Filters -->
        <div class="mx-auto mt-8 max-w-5xl sm:mt-12">
          <div class="card-glass p-4 sm:p-5 md:p-6">
            <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
              <div class="text-left">
                <h2 class="text-2xl md:text-3xl font-bold text-accent-coral">
                  Topics
                </h2>
                <p class="text-sm font-semibold text-dark/70">
                  Find your way in
                </p>
              </div>
              <div class="grid grid-cols-2 gap-2.5 sm:grid-cols-3 sm:gap-3 lg:grid-cols-5" data-topic-filters>
                {['All', ...uniqueTags].map((tag, index) => (
                  <button
                    type="button"
                    data-topic={tag}
                    aria-pressed={tag === 'All' ? 'true' : 'false'}
                    class:list={[
                      "min-h-12 px-2 py-2 border-2 border-dark text-sm text-dark font-bold shadow-[3px_3px_0_var(--neo-ink)] sm:px-3 sm:text-base sm:hover:-translate-x-0.5 sm:hover:-translate-y-0.5 sm:hover:shadow-[5px_5px_0_var(--neo-ink)] transition-all duration-200 rounded-md text-center",
                      index % 3 === 0 ? "bg-accent-cyan" : index % 3 === 1 ? "bg-accent-yellow" : "bg-accent-coral"
                    ]}
                  >
                    {tag === 'All' ? 'Everything' : tag}
                  </button>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Featured Posts -->
    {featuredPosts.length > 0 && (
      <section class="px-4 py-12 sm:px-6 sm:py-20 lg:px-8">
        <div class="max-w-7xl mx-auto">
          <h2 class="mb-7 text-center text-3xl font-bold text-electric-blue electric-blue-glow sm:mb-12 md:text-4xl">
            A good place to start
          </h2>
          
          <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
            {featuredPosts.map((post, index) => (
              <GlassCard padding="none" className="group p-5 transition-all duration-300 sm:p-6 md:hover:-translate-y-1">
                <div class="space-y-4">
                  {/* Category & Date */}
                  <div class="flex flex-wrap items-center justify-between gap-2 text-sm">
                    <span class="px-2 py-1 bg-accent-coral text-dark border-2 border-dark rounded-md font-bold shadow-[2px_2px_0_var(--neo-ink)]">
                      {index === 0 ? 'Latest' : 'Featured'}
                    </span>
                    <time class="text-gray-400" datetime={post.date.toISOString()}>
                      {formatDate(post.date)}
                    </time>
                  </div>
                  
                  {/* Title */}
                  <h3 class="text-xl font-semibold text-accent-cyan neon-glow">
                    <a href={`/blog/${post.slug}`} class="hover:text-accent-yellow transition-colors duration-300">
                      {post.title}
                    </a>
                  </h3>
                  
                  {/* Description */}
                  <p class="text-gray-300 text-sm leading-relaxed">
                    {post.excerpt}
                  </p>
                  
                  {/* Tags */}
                  <div class="flex flex-wrap gap-2">
                    {getPostBadges(post).map((badge) => (
                      <span class="text-xs px-2 py-1 bg-accent-cyan text-dark border-2 border-dark rounded-md font-bold shadow-[2px_2px_0_var(--neo-ink)]">
                        {badge}
                      </span>
                    ))}
                    <span class="text-xs px-2 py-1 bg-accent-yellow text-dark border-2 border-dark rounded-md font-bold shadow-[2px_2px_0_var(--neo-ink)]">
                      {readingMinutes(post)} min
                    </span>
                  </div>
                  
                  {/* Read More */}
                  <div class="pt-4">
                    <a 
                      href={`/blog/${post.slug}`}
                      class="inline-flex items-center text-accent-yellow hover:text-accent-cyan transition-colors duration-300"
                    >
                      Keep reading →
                    </a>
                  </div>
                </div>
              </GlassCard>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- All Posts -->
    <section id="latest-posts" class="px-4 py-12 sm:px-6 sm:py-20 lg:px-8">
      <div class="max-w-7xl mx-auto">
        <h2 class="mb-7 text-center text-3xl font-bold text-accent-coral neon-glow sm:mb-12 md:text-4xl">
          Everything else
        </h2>
        
        <div class="space-y-8">
          {sortedPosts.map((post) => (
            <div data-post-card data-topics={getPostTopics(post).join(',')}>
            <GlassCard padding="none" className="group p-5 transition-all duration-300 sm:p-6">
              <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div class="flex-1 min-w-0">
                  <div class="mb-2 flex flex-wrap items-center gap-2 sm:gap-4">
                    <time class="text-gray-400 text-sm whitespace-nowrap" datetime={post.date.toISOString()}>
                      {formatDate(post.date)}
                    </time>
                    <span class="px-2 py-1 bg-accent-yellow text-dark border-2 border-dark rounded-md text-xs font-bold shadow-[2px_2px_0_var(--neo-ink)]">
                      {readingMinutes(post)} min read
                    </span>
                  </div>
                  
                  <h3 class="text-xl md:text-2xl font-semibold text-white mb-2 group-hover:text-accent-cyan transition-colors duration-300">
                    <a href={`/blog/${post.slug}`} class="hover:neon-glow">
                      {post.title}
                    </a>
                  </h3>
                  
                  <p class="text-gray-400 mb-3">
                    {post.excerpt}
                  </p>
                  
                  <div class="flex flex-wrap gap-2">
                    {getPostBadges(post).map((badge) => (
                      <span class="text-xs px-2 py-1 bg-accent-cyan border-2 border-dark text-dark rounded-md font-bold shadow-[2px_2px_0_var(--neo-ink)]">
                        {badge}
                      </span>
                    ))}
                  </div>
                </div>
                
                <div class="flex-shrink-0">
                  <a 
                    href={`/blog/${post.slug}`}
                    class="inline-flex w-full items-center justify-center px-4 py-2 transition-all duration-300 sm:w-auto border border-accent-cyan text-accent-cyan hover:bg-accent-cyan hover:text-dark"
                  >
                    Read it →
                  </a>
                </div>
              </div>
            </GlassCard>
            </div>
          ))}
        </div>
      </div>
    </section>

  </main>

  <script>
    const initTopicFilters = () => {
      const filters = document.querySelector('[data-topic-filters]');
      if (!(filters instanceof HTMLElement) || filters.dataset.ready === 'true') return;
      filters.dataset.ready = 'true';

      filters.addEventListener('click', (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-topic]');
        if (!button) return;
        const topic = button.dataset.topic;

        filters.querySelectorAll('[data-topic]').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
        document.querySelectorAll<HTMLElement>('[data-post-card]').forEach((card) => {
          const topics = card.dataset.topics?.split(',') ?? [];
          card.hidden = topic !== 'All' && !topics.includes(topic ?? '');
        });
        document.querySelector('#latest-posts')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    };

    document.addEventListener('DOMContentLoaded', initTopicFilters);
    document.addEventListener('astro:page-load', initTopicFilters);
  </script>
</MainLayout>
