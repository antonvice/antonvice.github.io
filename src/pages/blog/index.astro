---
import MainLayout from '../../layouts/MainLayout.astro';
import { getAllPosts, formatDate } from '../../lib/posts';
import type { BlogPost } from '../../lib/posts';
import GlassCard from '../../components/GlassCard';

// Get all blog posts
const allPosts = getAllPosts();

// Sort posts by date (newest first)
const sortedPosts = [...allPosts].sort((a, b) =>
  new Date(b.date).valueOf() - new Date(a.date).valueOf()
);

// Get featured posts (first 3 for now)
const featuredPosts = sortedPosts.slice(0, 3);

// Extract unique tags from content (simple approach)
const uniqueTags = ['AI', 'Machine Learning', 'Deep Learning', 'Python', 'GPT', 'Neural Networks', 'Philosophy', 'Technology'];
const categories = ['AI & ML', 'Technical', 'Philosophy', 'Programming'];

const readingMinutes = (post: BlogPost) => Math.max(2, Math.ceil(post.content.split(/\s+/).length / 220));
const getPostBadges = (post: BlogPost): string[] => {
  const text = `${post.title} ${post.excerpt}`.toLowerCase();
  const badges = [];

  if (/rust|python|swift|code|programming|interview|rag/.test(text)) badges.push('Engineering');
  if (/transformer|gpt|llm|ai|machine learning|neural/.test(text)) badges.push('AI');
  if (/philosophy|ethic|future|anthropocentric|browser/.test(text)) badges.push('Essay');
  if (/clustering|quantization|kan|dbscan|optics/.test(text)) badges.push('Deep Dive');

  return (badges.length ? badges : ['Notes']).slice(0, 3);
};
---

<MainLayout title="Blog - Anton Vice" description="Essays, build notes, and practical AI research from Anton Vice.">
  
  <main id="main-content" class="pt-16">
    <!-- Hero Section -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
      <div class="max-w-7xl mx-auto relative z-10">
        <div class="text-center mb-12">
          <h1 class="text-5xl md:text-7xl font-bold text-neon-blue neon-blue-glow mb-6">
            Anton's Blog
          </h1>
          <p class="text-xl text-gray-300 max-w-3xl mx-auto leading-relaxed mb-8">
            Essays, build notes, and field reports from the places where AI, software,
            robotics, and ordinary human judgment keep bumping into each other.
          </p>
        </div>
        
        <!-- Stats -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-4xl mx-auto">
          <GlassCard padding="large" className="text-center">
            <div class="text-3xl font-bold text-neon-blue mb-2">{allPosts.length}</div>
            <div class="text-gray-400 text-sm">Posts</div>
          </GlassCard>
          <GlassCard padding="large" className="text-center">
            <div class="text-3xl font-bold text-accent-yellow mb-2">{categories.length}</div>
            <div class="text-gray-400 text-sm">Categories</div>
          </GlassCard>
          <GlassCard padding="large" className="text-center">
            <div class="text-3xl font-bold text-accent-coral mb-2">{uniqueTags.length}</div>
            <div class="text-gray-400 text-sm">Tags</div>
          </GlassCard>
          <GlassCard padding="large" className="text-center">
            <div class="text-3xl font-bold text-electric-blue mb-2">{sortedPosts[0] ? readingMinutes(sortedPosts[0]) : 0}</div>
            <div class="text-gray-400 text-sm">Min Latest</div>
          </GlassCard>
        </div>
      </div>
    </section>

    <!-- Featured Posts -->
    {featuredPosts.length > 0 && (
      <section class="py-20 px-4 sm:px-6 lg:px-8">
        <div class="max-w-7xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-bold text-electric-blue electric-blue-glow mb-12 text-center">
            Featured Posts
          </h2>
          
          <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
            {featuredPosts.map((post, index) => (
              <GlassCard padding="large" className="group hover:scale-105 transition-all duration-300">
                <div class="space-y-4">
                  {/* Category & Date */}
                  <div class="flex items-center justify-between text-sm">
                    <span class="px-2 py-1 bg-accent-coral text-dark border-2 border-dark rounded-md font-bold shadow-[2px_2px_0_var(--neo-ink)]">
                      {index === 0 ? 'Latest' : 'Featured'}
                    </span>
                    <time class="text-gray-400" datetime={post.date.toISOString()}>
                      {formatDate(post.date)}
                    </time>
                  </div>
                  
                  {/* Title */}
                  <h3 class="text-xl font-semibold text-accent-cyan neon-glow">
                    <a href={`/blog/${post.slug}`} class="hover:text-accent-yellow transition-colors duration-300">
                      {post.title}
                    </a>
                  </h3>
                  
                  {/* Description */}
                  <p class="text-gray-300 text-sm leading-relaxed">
                    {post.excerpt}
                  </p>
                  
                  {/* Tags */}
                  <div class="flex flex-wrap gap-2">
                    {getPostBadges(post).map((badge) => (
                      <span class="text-xs px-2 py-1 bg-accent-cyan text-dark border-2 border-dark rounded-md font-bold shadow-[2px_2px_0_var(--neo-ink)]">
                        {badge}
                      </span>
                    ))}
                    <span class="text-xs px-2 py-1 bg-accent-yellow text-dark border-2 border-dark rounded-md font-bold shadow-[2px_2px_0_var(--neo-ink)]">
                      {readingMinutes(post)} min
                    </span>
                  </div>
                  
                  {/* Read More */}
                  <div class="pt-4">
                    <a 
                      href={`/blog/${post.slug}`}
                      class="inline-flex items-center text-accent-yellow hover:text-accent-cyan transition-colors duration-300"
                    >
                      Read Essay →
                    </a>
                  </div>
                </div>
              </GlassCard>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- All Posts -->
    <section class="py-20 px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-accent-coral neon-glow mb-12 text-center">
          Latest Posts
        </h2>
        
        <div class="space-y-8">
          {sortedPosts.map((post) => (
            <GlassCard padding="large" className="group transition-all duration-300">
              <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-4 mb-2">
                    <time class="text-gray-400 text-sm whitespace-nowrap" datetime={post.date.toISOString()}>
                      {formatDate(post.date)}
                    </time>
                    <span class="px-2 py-1 bg-accent-yellow text-dark border-2 border-dark rounded-md text-xs font-bold shadow-[2px_2px_0_var(--neo-ink)]">
                      {readingMinutes(post)} min read
                    </span>
                  </div>
                  
                  <h3 class="text-xl md:text-2xl font-semibold text-white mb-2 group-hover:text-accent-cyan transition-colors duration-300">
                    <a href={`/blog/${post.slug}`} class="hover:neon-glow">
                      {post.title}
                    </a>
                  </h3>
                  
                  <p class="text-gray-400 mb-3">
                    {post.excerpt}
                  </p>
                  
                  <div class="flex flex-wrap gap-2">
                    {getPostBadges(post).map((badge) => (
                      <span class="text-xs px-2 py-1 bg-accent-cyan border-2 border-dark text-dark rounded-md font-bold shadow-[2px_2px_0_var(--neo-ink)]">
                        {badge}
                      </span>
                    ))}
                  </div>
                </div>
                
                <div class="flex-shrink-0">
                  <a 
                    href={`/blog/${post.slug}`}
                    class="inline-flex items-center px-4 py-2 border border-accent-cyan text-accent-cyan hover:bg-accent-cyan hover:text-dark transition-all duration-300"
                  >
                    Read More →
                  </a>
                </div>
              </div>
            </GlassCard>
          ))}
        </div>
      </div>
    </section>

    <!-- Tags Cloud -->
    <section class="py-20 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl font-bold text-neon-blue neon-blue-glow mb-8">
          Topics
        </h2>
        <div class="flex flex-wrap justify-center gap-3">
          {uniqueTags.map((tag) => (
            <span key={tag} class="px-3 py-2 bg-accent-cyan border-2 border-dark text-dark font-bold shadow-[3px_3px_0_var(--neo-ink)] hover:bg-accent-coral transition-all duration-300 cursor-pointer rounded-md">
              #{tag}
            </span>
          ))}
        </div>
      </div>
    </section>
  </main>
</MainLayout>
