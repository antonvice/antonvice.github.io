---
import MainLayout from '../layouts/MainLayout.astro';
import LanyardCard from '../components/LanyardCard';
import GlassCard from '../components/GlassCard';
import { getAllPosts, formatDate } from '../lib/posts';
import { portfolioProjects } from '../data/portfolio';

const posts = getAllPosts();
const latestPosts = posts.slice(0, 3);
const selectedProjects = portfolioProjects.slice(0, 4);
const interests = [
  'Local AI that respects the person using it',
  'Robots that can be tested, not just demoed',
  'Developer tools I wish already existed',
  'Writing through the strange parts of technology',
];
---

<MainLayout
  title="Anton Vice - AI Engineer, Builder, and Writer"
  description="Anton Vice builds practical AI systems, robotics tools, local software, and essays about what technology does to people."
>
  <main id="main-content" class="pt-20">
    <section class="flex min-h-[calc(100svh-5rem)] items-center px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto grid w-full max-w-6xl gap-12 lg:grid-cols-[1.12fr_0.88fr] lg:items-center">
        <div class="min-w-0">
          <div class="mb-6 inline-flex rotate-[-1deg] border-[3px] border-dark bg-accent-yellow px-4 py-2 font-rajdhani text-sm font-black uppercase shadow-[5px_5px_0_var(--neo-ink)]">
            Hi, I'm Anton.
          </div>
          <h1 class="max-w-4xl text-5xl font-black leading-[0.92] text-electric-blue electric-blue-glow sm:text-7xl lg:text-8xl">
            I build useful things with AI.
          </h1>
          <p class="mt-7 max-w-3xl text-xl font-semibold leading-relaxed text-dark sm:text-2xl">
            Usually that means local agents, robotics, developer tools, or an experiment that started with “I wonder if this would work.”
          </p>
          <p class="mt-4 max-w-2xl text-base font-medium leading-relaxed text-dark/75 sm:text-lg">
            I’m currently CTO at Grably. I was also part-time CTO at <a class="font-bold underline decoration-[var(--neo-pink)] decoration-2 underline-offset-2" href="https://xlabrobotics.com" target="_blank" rel="noopener noreferrer">XLab Robotics</a> from December 2025 to June 2026. This site is where I keep the work I’m proud of, the ideas I’m still testing, and the essays I wrote when building was not enough.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a class="neo-button bg-accent-cyan" href="/portfolio">See what I’ve built</a>
            <a class="neo-button bg-[var(--neo-surface)]" href="/blog">Read my writing</a>
            <a class="neo-button bg-accent-coral" href="mailto:anton96vice@gmail.com">Say hello</a>
          </div>
        </div>

        <div class="flex justify-center lg:justify-end">
          <LanyardCard
            name="Anton Vice"
            title="CTO at Grably"
            subtitle="AI Engineer | Austin, TX"
            description={['I like ambitious ideas', 'I like working software more']}
            socials={[
              { icon: '@', href: 'mailto:anton96vice@gmail.com', label: 'Email' },
              { icon: 'GH', href: 'https://github.com/antonvice', label: 'GitHub' },
              { icon: 'in', href: 'https://www.linkedin.com/in/antonvice', label: 'LinkedIn' },
            ]}
            client:load
          />
        </div>
      </div>
    </section>

    <section class="px-4 py-14 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <div class="mb-7 max-w-3xl">
          <p class="font-rajdhani text-sm font-black uppercase text-accent-coral">What I keep coming back to</p>
          <h2 class="mt-2 text-3xl font-black sm:text-5xl">The thread through the work</h2>
          <p class="mt-4 text-lg font-medium leading-relaxed text-dark/75">
            I care about capable systems, but I care just as much about who stays in control, whether the thing works outside a demo, and whether it is actually pleasant to use.
          </p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {interests.map((interest, index) => (
            <div class:list={['border-[3px] border-dark p-5 shadow-[6px_6px_0_var(--neo-ink)]', index % 3 === 0 ? 'bg-accent-coral' : index % 3 === 1 ? 'bg-accent-yellow' : 'bg-accent-cyan']}>
              <span class="font-rajdhani text-xl font-black leading-tight text-dark">{interest}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="font-rajdhani text-sm font-black uppercase text-accent-coral">A few favorites</p>
            <h2 class="mt-2 text-3xl font-black sm:text-5xl">Things I’ve made</h2>
          </div>
          <a class="font-rajdhani text-lg font-black text-dark underline decoration-[var(--neo-pink)] decoration-4 underline-offset-4" href="/portfolio">The full portfolio →</a>
        </div>
        <div class="grid gap-6 md:grid-cols-2">
          {selectedProjects.map((project, index) => (
            <article class:list={['card-glass p-6', index === 0 ? 'card-glass--feature' : index === 1 ? 'card-glass--special' : '']}>
              <div class="mb-4 flex flex-wrap gap-2">
                <span class="border-2 border-dark bg-accent-yellow px-2 py-1 text-xs font-black uppercase text-dark">{project.category}</span>
                <span class="border-2 border-dark bg-[var(--neo-surface)] px-2 py-1 text-xs font-black text-dark">{project.stack}</span>
              </div>
              <h3 class="text-3xl font-black"><a class="text-dark hover:text-accent-coral" href={project.href} target="_blank" rel="noopener noreferrer">{project.title}</a></h3>
              <p class="mt-4 font-semibold leading-relaxed text-dark">{project.summary}</p>
              <p class="mt-4 border-l-[6px] border-dark pl-4 font-medium leading-relaxed text-dark/75">{project.impact}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    {latestPosts.length > 0 && (
      <section class="px-4 py-16 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-6xl">
          <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="font-rajdhani text-sm font-black uppercase text-accent-coral">Notes from my head</p>
              <h2 class="mt-2 text-3xl font-black sm:text-5xl">Lately, I’ve been writing</h2>
            </div>
            <a class="font-rajdhani text-lg font-black text-dark underline decoration-[var(--neo-blue)] decoration-4 underline-offset-4" href="/blog">All posts →</a>
          </div>
          <div class="grid gap-5 md:grid-cols-3">
            {latestPosts.map((post, index) => (
              <GlassCard padding="large" variant={index === 0 ? 'special' : 'default'}>
                <time class="text-sm font-bold text-dark/60" datetime={post.date.toISOString()}>{formatDate(post.date)}</time>
                <h3 class="mt-3 text-2xl font-black leading-tight"><a class="text-dark hover:text-accent-coral" href={`/blog/${post.slug}`}>{post.title}</a></h3>
                <p class="mt-4 text-sm font-medium leading-relaxed text-dark/75">{post.excerpt}</p>
                <a class="mt-5 inline-block font-rajdhani font-black text-dark underline decoration-[var(--neo-pink)] decoration-2 underline-offset-4" href={`/blog/${post.slug}`}>Read it →</a>
              </GlassCard>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>
</MainLayout>
