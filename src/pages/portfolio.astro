---
import MainLayout from '../layouts/MainLayout.astro';
import { portfolioProjects } from '../data/portfolio';

const categories = [...new Set(portfolioProjects.map((project) => project.category))];
const featured = portfolioProjects.slice(0, 6);
---

<MainLayout
  title="Portfolio - Anton Vice"
  description="A simple project list for people who want to see what Anton Vice built and why it matters."
>
  <main id="main-content" class="pt-20">
    <section class="px-4 py-12 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="min-w-0">
          <div class="mb-5 inline-flex rotate-[-1deg] items-center border-[3px] border-dark bg-[var(--neo-yellow)] px-4 py-2 font-rajdhani text-sm font-black uppercase shadow-[5px_5px_0_var(--neo-ink)]">
            The edited version
          </div>
          <h1 class="max-w-5xl text-4xl font-black leading-[0.95] text-electric-blue electric-blue-glow sm:text-6xl lg:text-7xl">
            PORTFOLIO
          </h1>
          <p class="mt-6 max-w-3xl text-lg font-semibold leading-relaxed text-dark sm:text-xl">
            These are the projects I would pull up if we were sitting together and you asked what I have been working on. Some shipped, some taught me something, and some did both.
          </p>
        </div>

      </div>
    </section>

    <section class="px-4 py-8 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
          <h2 class="text-3xl font-black text-accent-cyan md:text-4xl">Pick a direction</h2>
          <div class="flex w-full max-w-full flex-wrap gap-2 sm:w-auto">
            <a class="border-[3px] border-dark bg-[var(--neo-blue)] px-4 py-2 font-rajdhani font-black uppercase text-dark shadow-[4px_4px_0_var(--neo-ink)]" href="/portfolio">Portfolio</a>
            <a class="border-[3px] border-dark bg-[var(--neo-surface)] px-4 py-2 font-rajdhani font-black uppercase text-dark shadow-[4px_4px_0_var(--neo-ink)]" href="/research">Research</a>
          </div>
        </div>
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
          {categories.map((category, index) => (
            <a
              href={`#${category.toLowerCase().replaceAll(' ', '-').replaceAll('/', '').replaceAll('&', 'and')}`}
              class:list={[
                'block border-[3px] border-dark p-4 font-rajdhani shadow-[6px_6px_0_var(--neo-ink)] transition-transform duration-200 hover:-translate-x-1 hover:-translate-y-1',
                index % 3 === 0 ? 'bg-[var(--neo-pink)]' : index % 3 === 1 ? 'bg-[var(--neo-yellow)]' : 'bg-[var(--neo-blue)]',
              ]}
            >
              <span class="text-sm font-black uppercase text-dark">{portfolioProjects.filter((project) => project.category === category).length} {portfolioProjects.filter((project) => project.category === category).length === 1 ? 'project' : 'projects'}</span>
              <strong class="mt-2 block text-2xl leading-none text-dark">{category}</strong>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="px-4 py-10 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <h2 class="mb-2 text-3xl font-black text-accent-coral md:text-4xl">The ones I’d show you first</h2>
        <p class="mb-7 max-w-3xl font-medium leading-relaxed text-dark/70">Not necessarily the biggest repos. They are the clearest examples of how I think: make the hard thing usable, keep the person close to the controls, and learn by building the whole loop.</p>
        <div class="grid gap-6 lg:grid-cols-3">
          {featured.map((project, index) => (
            <article class:list={['card-glass p-6', index === 0 ? 'lg:col-span-2 card-glass--feature' : '']}>
              <div class="mb-5 flex flex-wrap items-center gap-2">
                <span class="border-2 border-dark bg-[var(--neo-yellow)] px-3 py-1 text-xs font-black uppercase text-dark shadow-[3px_3px_0_var(--neo-ink)]">{project.category}</span>
                <span class="border-2 border-dark bg-[var(--neo-surface)] px-3 py-1 text-xs font-black uppercase text-dark shadow-[3px_3px_0_var(--neo-ink)]">{project.visibility}</span>
              </div>
              <h3 class="text-3xl font-black leading-none">
                {project.visibility === 'Public' ? (
                  <a class="text-dark underline decoration-[var(--neo-pink)] decoration-4 underline-offset-4" href={project.href} target="_blank" rel="noopener noreferrer">{project.title}</a>
                ) : <span class="text-dark">{project.title}</span>}
              </h3>
              <p class="mt-3 text-sm font-black uppercase text-accent-cyan">{project.stack}</p>
              <p class="mt-5 text-base font-semibold leading-relaxed text-dark">{project.summary}</p>
              <div class="mt-5 border-l-[8px] border-dark bg-[var(--neo-yellow)] p-4 shadow-[4px_4px_0_var(--neo-ink)]">
                <p class="text-sm font-black uppercase text-dark">Why I care about it</p>
                <p class="mt-2 font-semibold leading-relaxed text-dark">{project.impact}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="px-4 py-12 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <h2 class="mb-3 text-3xl font-black text-accent-cyan md:text-4xl">The rest of the work</h2>
        <p class="mb-8 max-w-3xl font-medium leading-relaxed text-dark/70">This is still selective. For every public repo, fork, and unfinished branch, the GitHub shelf has the less edited version.</p>
        <div class="space-y-10">
          {categories.map((category) => {
            const categoryProjects = portfolioProjects.filter((project) => project.category === category);
            const id = category.toLowerCase().replaceAll(' ', '-').replaceAll('/', '').replaceAll('&', 'and');

            return (
              <section id={id} class="scroll-mt-28">
                <div class="mb-5 flex items-center gap-4">
                  <h3 class="border-[3px] border-dark bg-[var(--neo-blue)] px-4 py-2 text-2xl font-black text-dark shadow-[5px_5px_0_var(--neo-ink)]">
                    {category}
                  </h3>
                  <span class="font-rajdhani text-lg font-black uppercase text-dark">{categoryProjects.length} builds</span>
                </div>
                <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
                  {categoryProjects.map((project) => (
                    <article class="card-glass p-5">
                      <div class="mb-4 flex flex-wrap gap-2">
                        <span class="border-2 border-dark bg-[var(--neo-pink)] px-2 py-1 text-xs font-black uppercase text-dark">{project.visibility}</span>
                        <span class="border-2 border-dark bg-[var(--neo-surface)] px-2 py-1 text-xs font-black uppercase text-dark">{project.stack}</span>
                      </div>
                      <h4 class="text-2xl font-black leading-none">
                        {project.visibility === 'Public' ? (
                          <a class="text-dark hover:text-accent-coral" href={project.href} target="_blank" rel="noopener noreferrer">{project.title}</a>
                        ) : <span class="text-dark">{project.title}</span>}
                      </h4>
                      <p class="mt-4 font-semibold leading-relaxed text-dark">{project.summary}</p>
                      <p class="mt-4 border-t-2 border-dark pt-4 text-sm font-bold leading-relaxed text-dark">{project.impact}</p>
                    </article>
                  ))}
                </div>
              </section>
            );
          })}
        </div>
      </div>
    </section>
  </main>
</MainLayout>
