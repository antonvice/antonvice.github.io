---
import MainLayout from '../layouts/MainLayout.astro';
import { researchProjects } from '../data/portfolio';

const themes = [...new Set(researchProjects.map((project) => project.theme))];
---

<MainLayout
  title="Research - Anton Vice"
  description="Notes on things I built, tested, and learned from robotics, AI, local tools, and simulation projects."
>
  <main id="main-content" class="pt-20">
    <section class="px-4 py-12 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="max-w-4xl">
          <div class="min-w-0">
            <div class="mb-5 inline-flex rotate-[1deg] items-center border-[3px] border-dark bg-[var(--neo-pink)] px-4 py-2 font-rajdhani text-sm font-black uppercase shadow-[5px_5px_0_var(--neo-ink)]">
              My lab notebook
            </div>
            <h1 class="max-w-4xl text-4xl font-black leading-[0.95] text-electric-blue electric-blue-glow sm:text-6xl lg:text-7xl">
              RESEARCH
            </h1>
            <p class="mt-6 max-w-3xl text-lg font-semibold leading-relaxed text-dark sm:text-xl">
              This is where I keep the work that began as a question. I am less interested in pretending every experiment was a breakthrough than in recording what I tried, what survived contact with reality, and what I would do differently next time.
            </p>
          </div>

        </div>
      </div>
    </section>

    <section class="px-4 py-8 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <h2 class="mb-5 text-3xl font-black text-accent-cyan md:text-4xl">Jump to</h2>
        <div class="flex flex-wrap gap-3">
          {themes.map((theme, index) => (
            <a
              href={`#${theme.toLowerCase().replaceAll(' ', '-').replaceAll('/', '').replaceAll('&', 'and')}`}
              class:list={[
                'border-[3px] border-dark px-4 py-2 font-rajdhani font-black uppercase text-dark shadow-[4px_4px_0_var(--neo-ink)] transition-transform duration-200 hover:-translate-x-1 hover:-translate-y-1',
                index % 3 === 0 ? 'bg-[var(--neo-yellow)]' : index % 3 === 1 ? 'bg-[var(--neo-blue)]' : 'bg-[var(--neo-pink)]',
              ]}
            >
              {theme}
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="px-4 py-12 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="space-y-8">
          {researchProjects.map((project, index) => {
            const id = project.theme.toLowerCase().replaceAll(' ', '-').replaceAll('/', '').replaceAll('&', 'and');

            return (
              <article
                id={id}
                class:list={[
                  'card-glass scroll-mt-28 p-5 md:p-7',
                  index % 4 === 0 ? 'card-glass--special' : index % 4 === 1 ? 'card-glass--feature' : '',
                ]}
              >
                <div class="grid gap-6 lg:grid-cols-[0.8fr_1.2fr]">
                  <header>
                    <div class="mb-4 flex flex-wrap gap-2">
                      <span class="border-2 border-dark bg-[var(--neo-pink)] px-3 py-1 text-xs font-black uppercase text-dark shadow-[3px_3px_0_var(--neo-ink)]">{project.status}</span>
                      <span class="border-2 border-dark bg-[var(--neo-yellow)] px-3 py-1 text-xs font-black uppercase text-dark shadow-[3px_3px_0_var(--neo-ink)]">{project.theme}</span>
                    </div>
                    <h2 class="text-3xl font-black leading-none md:text-4xl">
                      {project.href.includes('/Xlab-Jepa') || project.href.includes('/taif') || project.href.includes('/theplatform') || project.href.includes('/eidon-hand-detector') || project.href.includes('/M.A.N.D.A') ? (
                        <span class="text-dark">{project.title}</span>
                      ) : (
                        <a class="text-dark underline decoration-[var(--neo-blue)] decoration-4 underline-offset-4" href={project.href} target="_blank" rel="noopener noreferrer">{project.title}</a>
                      )}
                    </h2>
                    <p class="mt-4 text-sm font-black uppercase text-accent-cyan">{project.stack}</p>
                  </header>

                  <div class="grid gap-4 md:grid-cols-2">
                    <section class="border-[3px] border-dark bg-[var(--neo-surface)] p-4 shadow-[4px_4px_0_var(--neo-ink)]">
                      <h3 class="font-rajdhani text-lg font-black uppercase text-dark">What it is</h3>
                      <p class="mt-2 font-semibold leading-relaxed text-dark">{project.abstract}</p>
                    </section>
                    <section class="border-[3px] border-dark bg-[var(--neo-blue)] p-4 shadow-[4px_4px_0_var(--neo-ink)]">
                      <h3 class="font-rajdhani text-lg font-black uppercase text-dark">What I wanted to know</h3>
                      <p class="mt-2 font-semibold leading-relaxed text-dark">{project.hypothesis}</p>
                    </section>
                    <section class="border-[3px] border-dark bg-[var(--neo-yellow)] p-4 shadow-[4px_4px_0_var(--neo-ink)]">
                      <h3 class="font-rajdhani text-lg font-black uppercase text-dark">What I tested</h3>
                      <p class="mt-2 font-semibold leading-relaxed text-dark">{project.tested}</p>
                    </section>
                    <section class="border-[3px] border-dark bg-[var(--neo-surface)] p-4 shadow-[4px_4px_0_var(--neo-ink)]">
                      <h3 class="font-rajdhani text-lg font-black uppercase text-dark">What I learned</h3>
                      <p class="mt-2 font-semibold leading-relaxed text-dark">{project.discovered}</p>
                    </section>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  </main>
</MainLayout>
